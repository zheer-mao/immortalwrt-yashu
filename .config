# ImmortalWrt 编译配置：京东云 亚瑟 AX1800 Pro (jdcloud_re-ss-01)
# 用法：把本文件放进 GitHub 仓库根目录，工作流会自动复制并执行 make defconfig 展开
# 注意：不要往这个文件里写宽带账号、WiFi 密码等敏感信息（公开仓库所有人可见）

# 目标平台：高通 IPQ60xx
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re_ss_01=y

# LuCI 网页管理界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# 防火墙页面 + 中文
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# 软件包页面（新版叫 package-manager，老版叫 opkg，两个都写，存在的那个会被编入）
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-opkg=y

# dnsmasq-full（给 OpenClash 这类插件用，替代默认的 dnsmasq）
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
