# ImmortalWrt 纯净官方编译配置：京东云 亚瑟 AX1800 Pro (jdcloud_re-ss-01)
# 给朋友用的纯净版：只选设备 + LuCI，其他全部用官方默认（defconfig 展开）。无 argon/adblock/nginx/中文等额外包。
# 注意：设备行必须用横杠原样（jdcloud_re-ss-01），改成下划线会被 defconfig 静默丢弃，默认编出 8devices_mango-dvk。
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_PACKAGE_luci=y
